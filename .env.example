# NCREIF query-tool credentials.
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is gitignored -- it stays on your machine and is never pushed.
# Do NOT put real credentials in this .env.example file; it IS committed.
#
# Passwords are case-sensitive. No quotes needed unless the value has spaces.

NCREIF_EMAIL=you@firm.com
NCREIF_PASSWORD=your_password_here
